<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Optional: Add a border (stroke) -->
    <stroke
        android:width="2dp"
        android:color="#000000" />
    <!-- Optional: Add padding inside the shape -->
    <padding
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp" />
    <!-- Optional: Set size for a consistent circle regardless of view size, though view size usually controls final appearance -->
    <size
        android:width="100dp"
        android:height="100dp" />
</shape>